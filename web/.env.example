# Which network the app talks to: bohr (testnet, default) or mainnet. There is no silent fallback.
# "local" (an Anvil node, with NEXT_PUBLIC_LOCAL_CONTRACT) is for development and refused in production.
NEXT_PUBLIC_NETWORK=bohr

# Verify against https://dev-docs.botchain.ai/docs/Developers/quick-guide/ before deploying.
NEXT_PUBLIC_BOHR_RPC=https://rpc.bohr.life
NEXT_PUBLIC_MAINNET_RPC=https://rpc.botchain.ai

# Deployed TrueUp contract addresses, kept separate per network. Empty = not deployed yet.
NEXT_PUBLIC_BOHR_CONTRACT=
NEXT_PUBLIC_MAINNET_CONTRACT=
# Block the contract was deployed in, so event scans start there.
NEXT_PUBLIC_DEPLOY_BLOCK=

# The public origin used for share links and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: "fixtures" fills screens with layout-check data. Refused by production builds.
NEXT_PUBLIC_DATA_SOURCE=
