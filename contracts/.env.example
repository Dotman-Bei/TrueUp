# Copy to .env and fill in. contracts/.env is git-ignored; never commit it or share it.
# Foundry loads this file automatically when you run forge from contracts/.

# Deployer private key (0x-prefixed). Use a wallet that only holds test BOT from
# https://faucet.botchain.ai/basic, never one with real funds.
PRIVATE_KEY=

# Address that may change the fee for new markets and withdraw protocol fees.
OWNER=

# Optional. Fee for new markets in basis points (10 = 0.1%, max 500) and the largest stake in wei.
FEE_BPS=10
MAX_STAKE=100000000000000000000
